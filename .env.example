# Conexión de la aplicación (app_user, a través de PgBouncer)
DATABASE_URL=postgres://app_user:CAMBIAR@pgbouncer:6432/opscore

# Conexión para migraciones (rol dueño, directo a Postgres)
DATABASE_URL_OWNER=postgres://opscore_owner:CAMBIAR@postgres:5432/opscore

# Auth.js
AUTH_SECRET=generado_con_openssl_rand_base64_32
AUTH_URL=https://opscore.tudominio.com

# MinIO
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CAMBIAR
S3_SECRET_KEY=CAMBIAR
S3_BUCKET=opscore

# Postgres (para docker-compose)
POSTGRES_PASSWORD=CAMBIAR
DB_PASS=CAMBIAR
DB_OWNER_PASS=CAMBIAR
